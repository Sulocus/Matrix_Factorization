# =============================================================================
# sucia-backup branch: Track ALL project files
# (main branch has different .gitignore that ignores private directories)
# =============================================================================

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# =============================================================================
# IDE and Editor
# =============================================================================
.claude/
.idea/
.vscode/
*.swp
*.swo
*~

# =============================================================================
# System files
# =============================================================================
.DS_Store
Thumbs.db
*.log
# Exclude large result files from git push
# =============================================================================
# Large Data Files (experiments, checkpoints, results)
# =============================================================================
# PyTorch model/result files
*.pt
*.pth

# Pickle checkpoint files
*.pkl

# Large results directories (now tracked)
# smf/results/       # ENABLED: tracking results
# smf/Replica_results/  # ENABLED: tracking Replica results

# Checkpoint files
smf/.checkpoint.pt
.checkpoints/

# Large JSON metrics files (can exceed 10MB)
**/metrics.json

# Legacy/archive directories (local only, not synced)
_legacy/
